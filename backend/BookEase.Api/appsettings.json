{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BookEaseDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE-THIS-TO-A-SECURE-SECRET-KEY-AT-LEAST-32-CHARS-LONG!!",
    "Issuer": "BookEase",
    "Audience": "BookEaseApp",
    "ExpirationMinutes": 480
  },
  "BusinessSettings": {
    "TimeZoneId": "Arab Standard Time",
    "SlotIntervalMinutes": 30
  },
  "AdminSeed": {
    "Password": "Admin@123456"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/appointments",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "POST:/api/appointments/manage/verify",
        "Period": "1m",
        "Limit": 10
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
